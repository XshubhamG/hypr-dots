# Colors
include atheme

# config
set recolor false
set page-padding 0
set guioptions none
set adjust-open "best-fit"
set statusbar false
set statusbar-h-padding 5
set statusbar-v-padding 5
set statusbar-home-tilde true
set selection-clipboard clipboard
set window-title-home-tilde true
set database sqlite
set pages-per-row 1
set page-cache-size 100
set scroll-step 50
set render-loading true

# Keybindings
map P print
map r reload
map R rotate
map i recolor
map A zoom in
map D zoom out
map n navigate next
map u scroll half-up
map K scroll full-up
map d scroll half-down
map T toggle_page_mode
map J scroll full-down
map b toggle_statusbar
map p navigate previous
map <C-Tab> toggle_statusbar

# Fonts
set font "Poppins 12"
