{
  // ─── Theme & Visual Appearance ─────────────────────────────────────────────
  "theme": "Catppuccin Mocha",
  "icon_theme": "Catppuccin Mocha",
  "theme_overrides": {
    "Catppuccin Mocha": {
      "players": [
        {
          "cursor": "#cba6f7",
        },
      ],
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
  },

  // ─── Typography ────────────────────────────────────────────────────────────
  "ui_font_size": 20.0,
  "buffer_font_size": 18.0,
  "ui_font_family": "Poppins",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_weight": 300,
  "agent_ui_font_size": 18,
  "agent_buffer_font_size": 18,

  // ─── Editor Behavior ───────────────────────────────────────────────────────
  "relative_line_numbers": "enabled",
  "autosave": "on_focus_change",
  "show_whitespaces": "none",
  "current_line_highlight": "none",
  "extend_comment_on_newline": false,
  "base_keymap": "VSCode",
  "restore_on_file_reopen": true,
  "vim_mode": true,

  // ─── Title Bar ─────────────────────────────────────────────────────────────
  "title_bar": {
    "show_branch_icon": false,
    "show_branch_name": false,
    "show_project_items": false,
    "show_onboarding_banner": false,
    "show_user_picture": true,
    "show_sign_in": false,
    "show_menus": false,
  },

  // ─── Tab Bar ───────────────────────────────────────────────────────────────
  "tab_bar": {
    "show": true,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
  },
  "tabs": {
    "file_icons": true,
  },

  // ─── Gutter ────────────────────────────────────────────────────────────────
  "gutter": { "min_line_number_digits": 0, "folds": false, "runnables": false },

  // ─── Toolbar ───────────────────────────────────────────────────────────────
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false,
  },

  // ─── Minimap & Scrollbar ────────────────────────────────────────────────────
  "minimap": {
    "thumb_border": "none",
  },
  "scrollbar": {
    "show": "never",
  },

  // ─── Status Bar ────────────────────────────────────────────────────────────
  "status_bar": {
    "experimental.show": true,
    "cursor_position_button": false,
    "active_language_button": true,
  },

  // ─── Panels ─────────────────────────────────────────────────────────────────
  "project_panel": {
    "dock": "right",
    "button": false,
    "hide_hidden": false,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": false,
    "git_status": false,
  },
  "git_panel": {
    "tree_view": true,
  },
  "notification_panel": {
    "button": false,
  },

  // ─── Panel Buttons (UI clutter reduction) ────────────────────────────────────
  "debugger": {
    "log_dap_communications": true,
    "save_breakpoints": false,
    "button": false,
  },
  "search": {
    "button": false,
  },
  "diagnostics": {
    "button": false,
  },
  "terminal": {
    "scrollbar": {
      "show": "never",
    },
    "button": false,
  },

  // ─── AI & Agent ─────────────────────────────────────────────────────────────
  "disable_ai": false,
  "agent_servers": {
    "cursor": {
      "type": "registry",
    },
  },
  "agent": {
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager",
  },

  // ─── Languages ─────────────────────────────────────────────────────────────
  "languages": {
    // Python
    "Python": {
      "tab_size": 4,
      "language_servers": ["ty", "ruff", "!basedpyright"],
    },
  },
}
