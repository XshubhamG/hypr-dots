{
  // ─── Theme & Visual Appearance ─────────────────────────────────────────────
  "window_decorations": "client",
  "use_system_window_tabs": false,
  "bottom_dock_layout": "full",
  "file_finder": {
    "modal_max_width": "medium",
  },
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "which_key": {
    "enabled": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "restore_on_startup": "launchpad",
  "session": {
    "trust_all_worktrees": true,
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "show_edit_predictions": false,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha",
  },
  "icon_theme": "Catppuccin Mocha",
  "theme_overrides": {
    "Catppuccin Mocha": {
      "accents": ["#f38ba8"],
      "editor.active_line_number": "#f38ba8",
      "border.focused": "#f38ba8",
      "border.selected": "#f38ba8",
      "pane.focused_border": "#f38ba8",
      "players": [
        {
          "cursor": "#f38ba8",
        },
      ],
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
  },

  // ─── Typography ────────────────────────────────────────────────────────────
  "ui_font_size": 18.0,
  "buffer_font_size": 22.0,
  "ui_font_family": "Poppins",
  "buffer_font_family": "Iosevka Nerd Font",
  "buffer_font_weight": 300,
  "agent_ui_font_size": 18,
  "agent_buffer_font_size": 18,

  // ─── Editor Behavior ───────────────────────────────────────────────────────
  "relative_line_numbers": "enabled",
  "autosave": "on_window_change",
  "show_whitespaces": "none",
  "current_line_highlight": "none",
  "extend_comment_on_newline": false,
  "base_keymap": "VSCode",
  "restore_on_file_reopen": true,
  "vim_mode": true,

  // ─── Title Bar ─────────────────────────────────────────────────────────────
  "title_bar": {
    "button_layout": "platform_default",
    "show_user_menu": true,
    "show_branch_name": false,
    "show_project_items": false,
    "show_onboarding_banner": false,
    "show_user_picture": true,
    "show_sign_in": false,
    "show_menus": false,
  },

  // ─── Tab Bar ───────────────────────────────────────────────────────────────
  "tab_bar": {
    "show": true,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
  },
  "tabs": {
    "file_icons": true,
  },

  // ─── Gutter ────────────────────────────────────────────────────────────────
  "gutter": { "min_line_number_digits": 0, "folds": false, "runnables": false },

  // ─── Toolbar ───────────────────────────────────────────────────────────────
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false,
  },

  // ─── Minimap & Scrollbar ────────────────────────────────────────────────────
  "minimap": {
    "thumb_border": "none",
  },
  "scrollbar": {
    "show": "never",
  },

  // ─── Status Bar ────────────────────────────────────────────────────────────
  "status_bar": {
    "experimental.show": true,
    "cursor_position_button": false,
    "active_language_button": true,
  },

  // ─── Panels ─────────────────────────────────────────────────────────────────
  "project_panel": {
    "dock": "right",
    "button": true,
    "hide_hidden": false,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": false,
    "git_status": false,
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "notification_panel": {
    "button": false,
  },

  // ─── Panel Buttons (UI clutter reduction) ────────────────────────────────────
  "debugger": {
    "log_dap_communications": true,
    "save_breakpoints": false,
    "button": false,
  },
  "search": {
    "button": false,
  },
  "diagnostics": {
    "button": false,
  },
  "terminal": {
    "scrollbar": {
      "show": "never",
    },
    "button": false,
  },

  // ─── AI & Agent ─────────────────────────────────────────────────────────────
  "disable_ai": false,
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "medium",
        "mode": "agent-full-access",
        "model": "gpt-5.4-mini"
      },
      "type": "registry",
    },
    "gemini": {
      "type": "registry",
    },
    "cursor": {
      "default_config_options": {
        "mode": "agent",
        "model": "composer-2.5"
      },
      "type": "registry",
    },
  },
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
      "enable_thinking": false,
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager",
  },

  // ─── Languages ─────────────────────────────────────────────────────────────
  "languages": {
    // Python
    "Python": {
      "tab_size": 4,
      "language_servers": ["ty", "ruff", "!basedpyright"],
    },
  },
}
