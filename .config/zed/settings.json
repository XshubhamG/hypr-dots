{
  "git_panel": {
    "tree_view": true
  },
  "tab_bar": {
    "show_tab_bar_buttons": true
  },
  "prettier": {
    "allowed": true
  },
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "autosave": "on_focus_change",
  "vim_mode": true,
  "ui_font_size": 21.0,
  "buffer_font_size": 18.0,
  "base_keymap": "Cursor",
  "theme": "Catppuccin Mocha",
  "icon_theme": "Catppuccin Mocha",
  "format_on_save": "on",
  "experimental": {
    "systemd_integration": false
  }
}
