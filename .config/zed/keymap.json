[
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
      "ctrl-s": "workspace::Save",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space f": "editor::Format",
      "space i": "editor::OrganizeImports",
      "space j": "editor::GoToDiagnostic",
      "space k": "editor::GoToPreviousDiagnostic",
      "space p": "command_palette::Toggle",
      "space o": "outline::Toggle",
      "space x": "pane::CloseActiveItem",
      "space q a": "pane::CloseAllItems",
      "alt-k": "editor::MoveLineUp",
      "alt-j": "editor::MoveLineDown",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "x": "project_panel::Cut",
      "a": "project_panel::NewFile",
      "c": "project_panel::Copy",
      "o": "project_panel::Open",
      "p": "project_panel::Paste",
      "d": "project_panel::Trash",
      "r": "project_panel::Rename",
      "h": "project_panel::ToggleHideHidden",
      "shift-d": "project_panel::Delete",
      "shift-a": "project_panel::NewDirectory",
      "space /": "project_panel::CollapseAllEntries",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-e": null,
      "alt-c": "workspace::ActivatePreviousPane",
      "alt-e": "project_panel::ToggleFocus",
      "alt-l": "workspace::ToggleRightDock",
      "alt-h": "agent::Toggle",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "alt-r": null,
    },
  },
  {
    "context": "vim_operator == helix_previous",
    "unbind": {
      "space": "vim::InsertEmptyLineAbove",
    },
  },
  {
    "context": "vim_operator == helix_next",
    "unbind": {
      "space": "vim::InsertEmptyLineBelow",
    },
  },
]
